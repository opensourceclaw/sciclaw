{
  "name": "DeepClaw",
  "slug": "deepclaw",
  "version": "0.5.0",
  "description": "AI-powered deep research framework with multi-source search, content extraction, and intelligent synthesis",
  "owner": "Peter Cheng",
  "homepage": "https://github.com/opensourceclaw/deepclaw",
  "repository": "https://github.com/opensourceclaw/deepclaw",
  "license": "Apache-2.0",
  "keywords": [
    "research",
    "ai",
    "search",
    "llm",
    "openclaw",
    "deep-research"
  ],
  "platform": {
    "openclaw": ">=0.9.0"
  },
  "runtime": {
    "python": ">=3.10"
  },
  "commands": [
    {
      "name": "/research",
      "description": "Conduct deep research on any topic",
      "usage": "/research <topic> [options]",
      "examples": [
        "/research \"AI agents in 2026\"",
        "/research \"quantum computing\" --depth=deep --sources=20"
      ]
    }
  ],
  "dependencies": {
    "required": [
      "openclaw>=0.9.0",
      "requests>=2.28.0",
      "beautifulsoup4>=4.11.0",
      "click>=8.1.0",
      "rich>=13.0.0",
      "lxml>=4.9.0"
    ],
    "optional": {
      "api": [
        "python-jose[cryptography]>=3.3.0",
        "passlib[bcrypt]>=1.7.4",
        "python-dotenv>=1.0.0"
      ]
    }
  },
  "configuration": {
    "type": "object",
    "properties": {
      "search_provider": {
        "type": "string",
        "enum": ["duckduckgo", "tavily", "all"],
        "default": "all"
      },
      "llm_provider": {
        "type": "string",
        "enum": ["openai", "claude", "deepseek", "glm", "qwen", "kimi", "minimax"],
        "default": "openai"
      },
      "max_sources": {
        "type": "number",
        "default": 10,
        "minimum": 1,
        "maximum": 50
      },
      "cache_enabled": {
        "type": "boolean",
        "default": true
      },
      "output_format": {
        "type": "string",
        "enum": ["markdown", "html", "pdf"],
        "default": "markdown"
      }
    }
  },
  "permissions": [
    "network",
    "filesystem:read",
    "filesystem:write"
  ],
  "author": {
    "name": "Peter Cheng",
    "email": "peter@example.com"
  },
  "categories": [
    "research",
    "productivity",
    "ai"
  ]
}
