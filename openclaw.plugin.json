{
  "$schema": "https://openclaw.dev/schemas/plugin.json",
  "name": "sciclaw",
  "version": "4.0.0",
  "description": "Deep Research Framework - AI-powered multi-source research and synthesis",
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "capabilities": [
    "search",
    "research",
    "report",
    "api"
  ],
  "commands": {
    "search": {
      "description": "Search across multiple sources",
      "usage": "sciclaw search <query> [options]"
    },
    "research": {
      "description": "Deep research on a topic",
      "usage": "sciclaw research <topic> [options]"
    },
    "report": {
      "description": "Generate research report",
      "usage": "sciclaw report [options]"
    },
    "serve": {
      "description": "Start API server",
      "usage": "sciclaw serve [options]"
    }
  },
  "api": {
    "endpoints": [
      { "path": "/api/search", "method": "POST" },
      { "path": "/api/research", "method": "POST" },
      { "path": "/api/report/:id", "method": "GET" },
      { "path": "/api/report/:id", "method": "POST" },
      { "path": "/api/status", "method": "GET" }
    ],
    "defaultPort": 3000
  },
  "config": {
    "defaultEngine": "duckduckgo",
    "maxResults": 50,
    "timeout": 30000,
    "outputFormat": "markdown"
  },
  "dependencies": {
    "openclaw": ">=0.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
