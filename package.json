{
  "name": "sciclaw",
  "version": "4.0.0",
  "description": "Open-source Deep Research framework based on OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensourceclaw/sciclaw.git"
  },
  "homepage": "https://github.com/opensourceclaw/sciclaw#readme",
  "bugs": {
    "url": "https://github.com/opensourceclaw/sciclaw/issues"
  },
  "bin": {
    "sciclaw": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "node dist/api/server.js",
    "dev": "node --loader ts-node/esm src/cli/index.ts",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node dist/benchmark/run.js",
    "test:ga": "vitest run tests/ga/ga-acceptance.test.ts",
    "test:ga:live": "GA_LIVE=1 vitest run tests/ga/ga-live.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rm -rf dist/ node_modules/"
  },
  "keywords": [
    "openclaw",
    "deep-research",
    "search",
    "ai",
    "llm"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "claw-cog": "file:../claw-cog",
    "claw-mem": "file:../claw-mem",
    "claw-ctx": "file:../claw-ctx",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "marked": "^12.0.0",
    "ora": "^8.0.0",
    "pdfkit": "^0.15.0",
    "turndown": "^7.1.0",
    "uuid": "^9.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/turndown": "^5.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
