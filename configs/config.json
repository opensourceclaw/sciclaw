{
  "research": {
    "default_depth": 3,
    "max_results": 10,
    "max_content": 5,
    "timeout": 30,
    "default_engine": "duckduckgo"
  },
  "search": {
    "cache_enabled": true,
    "cache_ttl": 3600,
    "default_language": "en",
    "default_engine": "duckduckgo",
    "providers": {
      "bing": {
        "api_key": ""
      },
      "serpapi": {
        "api_key": ""
      },
      "serpapi_google": {
        "api_key": ""
      },
      "serpapi_bing": {
        "api_key": ""
      }
    }
  },
  "output": {
    "default_format": "markdown",
    "default_dir": "./reports"
  },
  "storage": {
    "default_path": "./data"
  }
}
